<?xml version="1.0"?>
<robot name="simple_camera_bot">

  <!-- Base link -->
  <!-- Origin = center of the 0.18x0.15 footprint, at ground level (Z=0).
       Physical reference: from the front-right corner of the chassis footprint
       (ground level), base_link is 0.09m back (-X) and 0.075m left (+Y).
       Measure all other joints (e.g. camera_joint below) from this point. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.15 0.18"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Camera link -->
  <link name="oak-d-base-frame">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 1.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Fixed joint from base to camera -->
  <!-- 3D-printed mount (2026-11-11): camera body center is 0.09m forward of base_link,
       0.095m above the ground.
       Yaw -0.05 rad (~-3 deg, turned toward the robot's right): unintended - the stand is
       too thin and the cable twists it. Estimated from a top-down photo, not measured
       precisely; re-check if the stand is reprinted or the cable re-routed. -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="oak-d-base-frame"/>
    <origin xyz="0.09 0 0.095" rpy="0 0 -0.05"/>
  </joint>

</robot>
