  "userNodes": {
    "diag-values": {
      "name": "diag_values",
      "sourceCode": "// Diagnostic values are strings, which Plot can't graph. Republish every numeric\n// key/value as a number: /studio_script/diag_values.values[:]{name==\"...\"}{key==\"...\"}.value\nimport { Input } from \"./types\";\n\nexport const inputs = [\"/diagnostics\"];\nexport const output = \"/studio_script/diag_values\";\n\ntype Value = { name: string; key: string; value: number };\ntype Output = { values: Value[] };\n\nexport default function script(event: Input<\"/diagnostics\">): Output {\n  const values: Value[] = [];\n  for (const status of event.message.status) {\n    for (const kv of status.values) {\n      const value = parseFloat(kv.value);\n      if (!Number.isNaN(value)) {\n        values.push({ name: status.name, key: kv.key, value });\n      }\n    }\n  }\n  return { values };\n}\n"
    }
  },
